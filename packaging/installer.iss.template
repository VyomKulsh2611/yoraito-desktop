; Inno Setup script for yoraito-sync
; Build from the repository root after PyInstaller: iscc packaging\yoraito-sync.iss
;   (scripts/build-windows.sh does both; it passes /DAppVersion=<version>)
; Output: dist\yoraito-sync-setup.exe

#ifndef AppVersion
  #define AppVersion "0.1.0"
#endif

[Setup]
; AppId identifies the install for upgrades and uninstall. Never change it: a new id would
; install a second copy next to the old one instead of upgrading it.
AppId={{250E2FB3-6817-4325-BAFD-99836FE91077}
AppName=__TOOL_NAME__
AppVersion={#AppVersion}
AppVerName=__TOOL_NAME__ {#AppVersion}
WizardStyle=modern
; An upgrade or uninstall first asks a running Yoraito Sync to close.
CloseApplications=yes
AppPublisher=Yoraito
AppPublisherURL=https://yoraito.ai
; Relative paths below are from the repository root, not from this folder.
SourceDir=..
DefaultDirName={autopf}\Yoraito Sync
DefaultGroupName=__TOOL_NAME__
OutputDir=dist
OutputBaseFilename=__TOOL_NAME_LOWER__-setup
Compression=lzma2
SolidCompression=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=lowest
UninstallDisplayIcon={app}\__TOOL_NAME_LOWER__.exe

[Files]
Source: "dist\yoraito-sync.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "packaging\README.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "dist\THIRD-PARTY-NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\__TOOL_NAME__"; Filename: "{app}\__TOOL_NAME_LOWER__.exe"
Name: "{group}\Read me"; Filename: "{app}\README.txt"
Name: "{group}\Uninstall Yoraito Sync"; Filename: "{uninstallexe}"
Name: "{autodesktop}\__TOOL_NAME__"; Filename: "{app}\__TOOL_NAME_LOWER__.exe"; Tasks: desktopicon

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional icons:"
Name: "startup"; Description: "Start Yoraito Sync when I sign in to Windows"; GroupDescription: "Startup:"

[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; ValueType: string; ValueName: "__TOOL_NAME_PASCAL__"; ValueData: """{app}\__TOOL_NAME_LOWER__.exe"""; Flags: uninsdeletevalue; Tasks: startup

[Run]
Filename: "{app}\__TOOL_NAME_LOWER__.exe"; Description: "Launch Yoraito Sync"; Flags: nowait postinstall skipifsilent

; No [UninstallDelete]: the ledger, settings and sync history in %USERPROFILE%\.yoraito are the
; user's data and are shared with other Yoraito tools, so uninstalling keeps them (see README.txt).
