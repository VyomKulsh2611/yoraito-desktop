"""Backend entry point for the Yoraito desktop app (Electron starts this program).

It is the same FastAPI app as the web version, run quietly for the desktop shell:

* no console window and no browser: Electron shows the interface;
* the port comes from Electron (``YORAITO_PORT``); the server only listens on 127.0.0.1;
* all data lives in ``%LOCALAPPDATA%\\Yoraito\\`` (database, kept review files, logs), never in the install folder;
* review history made by the earlier one-file program (``%LOCALAPPDATA%\\yoraito-model-diff\\``) is COPIED
  across the first time, never moved or overwritten;
* the routes that could send data to another service (AI summaries, Google Sheets by URL) are switched off,
  and the environment variables that would enable them are ignored;
* if Electron disappears without stopping us (a crash), this program notices and exits.

This file does not change the web app or the comparison engine; it only starts them.
"""
from __future__ import annotations

import os
import shutil
import sys
import threading
import time
from pathlib import Path

# Running without a console (PyInstaller --noconsole): uvicorn's logging expects real streams.
if sys.stdout is None:
    sys.stdout = open(os.devnull, "w")
if sys.stderr is None:
    sys.stderr = open(os.devnull, "w")

bundle_dir = getattr(sys, "_MEIPASS", os.path.dirname(os.path.abspath(__file__)))
for candidate in (os.path.join(bundle_dir, "src"), os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src")):
    if os.path.isdir(candidate):
        sys.path.insert(0, os.path.abspath(candidate))
        break

APP_FOLDER = "__APP_FOLDER__"
LEGACY_FOLDER = "__LEGACY_FOLDER__"

# Routes that can send file contents to another service. The desktop app never needs them.
BLOCKED_PREFIXES = ("/api/ai-summary", "/api/llm-status", "/api/diff-sheets")

# Settings that would switch on a cloud service. Removed so a stray environment variable cannot enable them.
SCRUBBED_ENV = (
    "YORAITO_AI_PROVIDER", "YORAITO_AI_API_KEY", "YORAITO_AI_BASE_URL", "YORAITO_AI_MODEL",
    "YORAITO_GOOGLE_CREDENTIALS", "ANTHROPIC_API_KEY", "OPENAI_API_KEY",
)


def local_app_data() -> Path:
    base = os.environ.get("LOCALAPPDATA") or os.path.expanduser("~")
    return Path(base)


def data_dir() -> Path:
    """Where this user's data lives (created if missing)."""
    path = local_app_data() / APP_FOLDER
    path.mkdir(parents=True, exist_ok=True)
    return path


def migrate_legacy_data(new_dir: Path, legacy_dir: Path) -> str:
    """Copy review history from the old folder into the new one. Returns what happened.

    Copy, never move: the old folder is left exactly as it was. Nothing in ``new_dir`` is overwritten: if a
    database already exists there, nothing is copied.
    """
    legacy_db = legacy_dir / "reviews.db"
    new_db = new_dir / "reviews.db"
    if not legacy_db.is_file():
        return "no earlier data"
    if new_db.exists():
        return "kept existing data"
    made: list[Path] = []
    try:
        for name in ("reviews.db", "reviews.db.wal"):
            src = legacy_dir / name
            if src.is_file():
                shutil.copy2(src, new_dir / name)
                made.append(new_dir / name)
        old_files = legacy_dir / "review_files"
        new_files = new_dir / "review_files"
        if old_files.is_dir() and not new_files.exists():
            shutil.copytree(old_files, new_files)
            made.append(new_files)
    except Exception:
        # Leave no half-copied database behind: the next start tries again from the untouched original.
        for path in made:
            if path.is_dir():
                shutil.rmtree(path, ignore_errors=True)
            else:
                path.unlink(missing_ok=True)
        raise
    return "copied earlier data"


def _process_is_running(pid: int) -> bool:
    if sys.platform != "win32":
        try:
            os.kill(pid, 0)
            return True
        except OSError:
            return False
    import ctypes
    from ctypes import wintypes

    PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
    STILL_ACTIVE = 259
    kernel32 = ctypes.windll.kernel32
    kernel32.OpenProcess.restype = wintypes.HANDLE
    handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
    if not handle:
        return False  # no such process
    try:
        code = wintypes.DWORD()
        if not kernel32.GetExitCodeProcess(handle, ctypes.byref(code)):
            return True
        return code.value == STILL_ACTIVE
    finally:
        kernel32.CloseHandle(handle)


def _exit_when_parent_dies(parent_pid: int) -> None:
    while True:
        time.sleep(2)
        if not _process_is_running(parent_pid):
            os._exit(0)


def block_external_routes(app) -> None:
    """Answer 404 for the routes in BLOCKED_PREFIXES (added before the server starts)."""
    from fastapi.responses import JSONResponse

    @app.middleware("http")
    async def _block_external_routes(request, call_next):
        if request.url.path.startswith(BLOCKED_PREFIXES):
            return JSONResponse(status_code=404, content={"detail": "Not available in the desktop app."})
        return await call_next(request)


def configure_environment() -> Path:
    for name in SCRUBBED_ENV:
        os.environ.pop(name, None)
    base = data_dir()
    try:
        outcome = migrate_legacy_data(base, local_app_data() / LEGACY_FOLDER)
    except Exception as exc:  # never stop the app over this: it starts with an empty history and says why
        outcome = f"could not copy earlier data ({exc.__class__.__name__}); the original was not touched"
    logs = base / "logs"
    logs.mkdir(parents=True, exist_ok=True)
    os.environ["YORAITO_REVIEW_DB"] = str(base / "reviews.db")
    os.environ["YORAITO_REVIEW_FILES"] = str(base / "review_files")
    os.environ["YORAITO_LOG_FILE"] = str(logs / "backend.log")
    os.environ["YORAITO_NO_BROWSER"] = "1"
    try:
        with open(logs / "backend.log", "a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} startup data={base} legacy_migration={outcome}\n")
    except OSError:
        pass
    return base


def main() -> None:
    port = os.environ.get("YORAITO_PORT")
    if not port or not port.isdigit():
        print("YORAITO_PORT must be set by the desktop shell.", file=sys.stderr)
        sys.exit(2)
    configure_environment()

    parent = os.environ.get("YORAITO_PARENT_PID")
    if parent and parent.isdigit():
        threading.Thread(target=_exit_when_parent_dies, args=(int(parent),), daemon=True).start()

    from __ENTRY_MODULE__ import app, main as run_server

    block_external_routes(app)
    run_server()  # binds 127.0.0.1:YORAITO_PORT and blocks


if __name__ == "__main__":
    main()
